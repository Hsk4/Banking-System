CORS_ORIGIN=http://localhost:3000

# --- limits: every value below is optional and falls back to the default ---
# the most one transfer may move
# LIMIT_PER_TRANSFER=100000
# the most one account may send across a rolling 24 hours
# LIMIT_DAILY_PER_ACCOUNT=250000
# above this, a transfer needs a code emailed to the account owner
# LIMIT_STEP_UP_THRESHOLD=50000
# STEP_UP_CODE_TTL_MINUTES=10
# STEP_UP_CODE_ATTEMPTS=5

# --- abuse limits ---
# failed sign-ins before that email is paused, and for how long
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_WINDOW_MINUTES=15
# requests per window, per IP, on /api/auth/register and /api/auth/login
# RATE_AUTH_MAX=10
# RATE_AUTH_WINDOW_MINUTES=10
# requests per window, per user, on transfers and recipient lookups
# RATE_USER_MAX=30
# RATE_USER_WINDOW_MINUTES=10