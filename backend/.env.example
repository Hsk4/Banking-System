MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_DB_COMPASS=
JWT_SECRET=
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET = 
