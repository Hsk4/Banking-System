# Public configuration for the app shell.
# Copy to `.env.local` for development, and set the same values in the Vercel
# project settings. Nothing here is secret: NEXT_PUBLIC_* is inlined at build
# time, so never put a credential in one.

# Absolute URL of the Express API, without a trailing slash.
# Required for the Capacitor build, which has no server and therefore no
# `/api/*` proxy. When it is unset, `lib/api.ts` falls back to the Render URL.
NEXT_PUBLIC_API_URL=https://banking-system-r8bq.onrender.com

# Optional: name of the client cookie that records a session *marker* only.
# The real credential is the token the API returns; see docs/capacitor-adding-plan.md.
# NEXT_PUBLIC_AUTH_COOKIE=banking_session
